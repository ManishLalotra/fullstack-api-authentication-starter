PORT=4000
NODE_ENV=development
JWT_ACCESS_SECRET=your_jwt_access_token_secret_key_32_bytes_min
JWT_REFRESH_SECRET=your_jwt_refresh_token_secret_key_32_bytes_min
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Redis Session & Token Blacklist
REDIS_HOST=localhost
REDIS_PORT=6379

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres_pass@localhost:5432/auth_db
